{
  "name": "one-piece-tcg-site",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node ./scripts/generateJapaneseSitemap.js && node ./node_modules/vite/bin/vite.js build",
    "seo:sitemap:jp": "node ./scripts/generateJapaneseSitemap.js",
    "start": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 4173",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:assets": "node ./scripts/generateAndroidReleaseAssets.js",
    "sync:cards": "node ./scripts/syncOfficialCards.js",
    "prepare:card-db": "node ./scripts/prepareCardDbSeed.js",
    "validate:card-api": "node ./scripts/validateCardApiContract.js",
    "upload:card-db": "node ./scripts/uploadCardDbToSupabase.js",
    "sync:topics": "node ./scripts/syncOfficialTopics.js",
    "collect:market": "node ./scripts/runMarketCollectorCycle.js",
    "backfill:sold-listings": "node ./scripts/backfillSnkrdunkSoldListings.js",
    "collect:market-history": "node ./scripts/runSnkrdunkTradeHistoryCycle.js",
    "rebuild:market-daily-points": "node ./scripts/rebuildFilteredMarketDailyPoints.js",
    "generate:card-thumbnails": "node ./scripts/generateCardThumbnails.js",
    "verify:card-thumbnails": "node ./scripts/verifyCardThumbnails.js",
    "rebuild:market-indexes": "node ./scripts/rebuildMarketIndexes.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/push-notifications": "^8.0.0",
    "@supabase/supabase-js": "^2.105.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.7"
  }
}
